# KallpaLearn AI - Variables de Entorno
# 
# IMPORTANTE: Las API keys NUNCA deben estar en el frontend
# Estas variables solo configuran qué proveedores usar
# Las API keys se manejan en el backend

# AI Provider Configuration
# Opciones: demo, openai, anthropic, custom
VITE_AI_PROVIDER=demo

# Embeddings Configuration
# Opciones: demo, openai, custom
VITE_EMBEDDINGS_PROVIDER=demo
VITE_EMBEDDINGS_ENABLED=true

# Transcription Provider
# Opciones: demo, whisper, custom
VITE_TRANSCRIPTION_PROVIDER=demo

# OCR Provider
# Opciones: demo, tesseract, custom
VITE_OCR_PROVIDER=demo

# Storage Provider
# Opciones: local, supabase, s3
VITE_STORAGE_PROVIDER=local

# Feature Flags
VITE_YOUTUBE_ENABLED=false
VITE_WEB_SCRAPING_ENABLED=false

# Backend URL (para cuando conectes el backend)
# VITE_BACKEND_URL=http://localhost:3001
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
