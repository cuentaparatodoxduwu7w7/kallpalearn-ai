# ============================================
# KallpaLearn AI - Variables de Entorno
# ============================================
# Copia este archivo a .env.local y completa los valores
# NUNCA subas .env.local a git

# ============================================
# SUPABASE (Frontend - Solo claves públicas)
# ============================================
# Obtén estos valores de: https://app.supabase.com/project/_/settings/api
# IMPORTANTE: Solo usa la anon/public key, NUNCA la service_role key
SUPABASE_URL=your-project-url.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# ============================================
# AI PROVIDER (Configuración del proveedor)
# ============================================
# Opciones: demo, openai, anthropic
# IMPORTANTE: Las API keys reales van en Supabase Edge Functions Secrets
# NO pongas API keys aquí ni en el frontend
AI_PROVIDER=demo
AI_MODEL=gpt-4o-mini

# ============================================
# EMBEDDINGS
# ============================================
# Habilitar/deshabilitar generación de embeddings
VITE_EMBEDDINGS_ENABLED=true

# ============================================
# FEATURE FLAGS
# ============================================
VITE_YOUTUBE_ENABLED=false
VITE_WEB_SCRAPING_ENABLED=false

# ============================================
# NOTA IMPORTANTE SOBRE SEGURIDAD
# ============================================
# Las API keys de proveedores de IA (OpenAI, Anthropic, etc.)
# deben configurarse ÚNICAMENTE en Supabase Edge Functions Secrets:
# https://app.supabase.com/project/_/settings/secrets
#
# Variables que debes configurar en Supabase Edge Functions:
# - OPENAI_API_KEY (si usas OpenAI)
# - ANTHROPIC_API_KEY (si usas Anthropic)
# - AI_PROVIDER (demo, openai, anthropic)
# - AI_MODEL (gpt-4o-mini, claude-3-5-sonnet-20241022, etc.)
#
# NUNCA pongas estas claves en:
# - Este archivo (.env.local)
# - El código frontend (src/)
# - GitHub Actions
# - localStorage del navegador
